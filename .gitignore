# ==========================================
# SpeakUp Application .gitignore
# ==========================================

# 1. Environment variables & Secrets
# Keep secrets out of version control; use .env.example instead
**/.env
**/.env.*
**/.env.local
!**/.env.example

# 2. Node.js & Backend
**/node_modules/
**/.storage/
backend/data/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json.bak

# 3. Flutter & Dart
**/build/
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.pub-cache/
**/.pub/
*.iml
*.ipr
*.iws

# 4. Logs, Dumps & Temp Files
analyze_out.txt
*.log
*.tmp

# 5. IDEs & Operating System
.vscode/
.idea/
*.DS_Store
Thumbs.db
