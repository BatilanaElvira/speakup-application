PORT=5000
NODE_ENV=development

# 🌐 MySQL Database Configuration (Optional: falls back to built-in memory store if unavailable)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=speakup_db
DB_SSL=false

# 🔐 JWT Authentication Secret
JWT_SECRET=speakup_jwt_secret_key_2026_super_secure!

# 🤖 Google Gemini AI (Optional: falls back to intelligent heuristic scoring if empty)
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# 💳 DigiPay Payment Gateway Credentials
DIGIPAY_API_KEY=
DIGIPAY_APP_ID=speakup_app
DIGIPAY_BASE_URL=https://digitalcertify.tech/v1/api
